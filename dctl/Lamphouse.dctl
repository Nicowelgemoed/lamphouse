// Lamphouse: a display rendering transform for DaVinci Resolve whose looks are rendered by a
// physical photochemical model (colour negative -> printer -> print -> projector).
// https://github.com/Nicowelgemoed/lamphouse
//
// Scene-referred camera log in, display out (SDR or HDR). Use via the ResolveFX DCTL plugin on the
// last node: halation reads neighbouring pixels and grain uses the timeline frame index.
//
// Derived from spektrafilm by Andrea Volpato, https://github.com/andreavolpato/spektrafilm
// Licensed CC BY-SA 4.0, https://creativecommons.org/licenses/by-sa/4.0/
// Modified by Nico Welgemoed: film profiles resampled and baked into this DCTL with an original
// rendering model and display transform (see CHANGELOG.txt in the Lamphouse repository).
// This file is licensed CC BY-SA 4.0. Not affiliated with or endorsed by Kodak or Andrea Volpato.
// Build: Lamphouse v1.1.0, 2026-11-06, 10 nm x 37 samples

DEFINE_UI_PARAMS(in_space, Input, DCTLUI_COMBO_BOX, 0, { IN_DWG, IN_ACESCCT, IN_LOGC3, IN_LOGC4, IN_SLOG3, IN_LOG3G10, IN_VLOG, IN_LINDWG }, { DaVinci WG Intermediate, ACEScct, ARRI LogC3 AWG3, ARRI LogC4 AWG4, Sony S-Log3 SGamut3.Cine, RED Log3G10 RWG, Panasonic V-Log V-Gamut, Linear DaVinci WG })
DEFINE_UI_PARAMS(look, Look, DCTLUI_COMBO_BOX, 0, { LK_CLASSIC, LK_NIGHT, LK_FINE, LK_SOFT, LK_BOLD, LK_SILVER }, { Classic, Night, Fine, Soft, Bold, Silver })
DEFINE_UI_PARAMS(response, Response, DCTLUI_COMBO_BOX, 0, { RS_LOOK, RS_FASTT, RS_DAY, RS_FINET, RS_FINED }, { Use Look, Fast Tungsten, Daylight, Fine Tungsten, Fine Daylight })
DEFINE_UI_PARAMS(print_base, Print Base, DCTLUI_COMBO_BOX, 0, { PB_LOOK, PB_CLASSIC, PB_DEEP }, { Use Look, Classic, Deep })
DEFINE_UI_PARAMS(process, Process, DCTLUI_COMBO_BOX, 0, { PR_LOOK, PR_NORMAL, PR_STRONG, PR_SILVER }, { Use Look, Normal, Strong, Silver })
DEFINE_UI_PARAMS(exposure, Exposure, DCTLUI_SLIDER_FLOAT, 0.0, -4.0, 4.0, 0.05)
DEFINE_UI_PARAMS(development, Development, DCTLUI_SLIDER_FLOAT, 0.0, -1.0, 2.0, 0.25)
DEFINE_UI_PARAMS(separation, Colour Separation, DCTLUI_SLIDER_FLOAT, 0.3, 0.0, 3.0, 0.05)
DEFINE_UI_PARAMS(brightness, Brightness, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(bal_r, Red Balance, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(bal_g, Green Balance, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(bal_b, Blue Balance, DCTLUI_SLIDER_FLOAT, 0.0, -12.0, 12.0, 0.5)
DEFINE_UI_PARAMS(contrast, Contrast, DCTLUI_SLIDER_FLOAT, 1.0, 0.6, 1.6, 0.01)
DEFINE_UI_PARAMS(silver, Silver Retention, DCTLUI_SLIDER_FLOAT, 0.0, 0.0, 1.0, 0.01)
DEFINE_UI_PARAMS(halation, Halation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 4.0, 0.05)
DEFINE_UI_PARAMS(halation_size, Halation Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.3, 3.0, 0.05)
DEFINE_UI_PARAMS(grain, Grain, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 3.0, 0.05)
DEFINE_UI_PARAMS(grain_size, Grain Size, DCTLUI_SLIDER_FLOAT, 1.0, 0.5, 2.5, 0.05)
DEFINE_UI_PARAMS(format, Format, DCTLUI_COMBO_BOX, 0, { FM_35, FM_16, FM_65 }, { Standard 35mm, Small 16mm, Large 65mm })
DEFINE_UI_PARAMS(display, Display, DCTLUI_COMBO_BOX, 0, { DS_709, DS_SRGB, DS_DP3, DS_P3, DS_PQ, DS_HLG, DS_RCM }, { Rec.709 Gamma 2.4, sRGB Display 2.2, Display P3 2.2, P3-D65 Gamma 2.6, Rec.2100 PQ, Rec.2100 HLG, DWG DI for RCM })
DEFINE_UI_PARAMS(peak_nits, HDR Peak Nits, DCTLUI_SLIDER_FLOAT, 1000.0, 400.0, 4000.0, 10.0)
DEFINE_UI_PARAMS(grey_nits, Mid Grey Nits, DCTLUI_SLIDER_FLOAT, 10.0, 5.0, 25.0, 0.1)
DEFINE_UI_PARAMS(surround, Surround, DCTLUI_COMBO_BOX, 0, { SR_DARK, SR_DIM, SR_BRIGHT }, { Dark, Dim, Bright })
DEFINE_UI_PARAMS(creative_white, Creative White, DCTLUI_COMBO_BOX, 0, { CW_D65, CW_D60, CW_D55, CW_D50 }, { D65, D60, D55, D50 })

DEFINE_UI_TOOLTIP(Look, "Classic: clean daylight rendering. Night: fast tungsten response, more grain and halation. Fine: finest grain, deep blacks. Soft: lower contrast. Bold: denser, richer, harder. Silver: retained-silver process, high contrast, muted colour.")
DEFINE_UI_TOOLTIP(Response, "Override the look's capture response: spectral sensitivity, tone curve, colour and grain of the capture stage.")
DEFINE_UI_TOOLTIP(Print Base, "Override the look's print: Classic, or Deep for denser blacks and higher contrast.")
DEFINE_UI_TOOLTIP(Process, "Override the look's process. Strong: pushed, richer, harder. Silver: retained silver.")
DEFINE_UI_TOOLTIP(Exposure, "Exposure into the capture stage, in stops.")
DEFINE_UI_TOOLTIP(Development, "Development push or pull in stops: contrast and density of the capture stage.")
DEFINE_UI_TOOLTIP(Colour Separation, "Interlayer colour effect: more separation between hues, neutrals untouched. 0.3 = calibrated.")
DEFINE_UI_TOOLTIP(Brightness, "Print brightness in printer points. +1 point = 0.025 log exposure.")
DEFINE_UI_TOOLTIP(Red Balance, "Printer-point colour balance. Positive = more red, negative = more cyan.")
DEFINE_UI_TOOLTIP(Green Balance, "Printer-point colour balance. Positive = more green, negative = more magenta.")
DEFINE_UI_TOOLTIP(Blue Balance, "Printer-point colour balance. Positive = more blue, negative = more yellow.")
DEFINE_UI_TOOLTIP(Contrast, "Print contrast around mid grey.")
DEFINE_UI_TOOLTIP(Silver Retention, "Neutral silver left in the image: more contrast, muted colour. Brightness compensates to hold mid grey.")
DEFINE_UI_TOOLTIP(Format, "Sets halation and grain size relative to the frame.")
DEFINE_UI_TOOLTIP(Display, "Your display. DWG DI for RCM: set Resolve Color Management output tone mapping and gamut mapping to None.")
DEFINE_UI_TOOLTIP(HDR Peak Nits, "Display peak luminance for Rec.2100 PQ and HLG. Ignored for SDR.")
DEFINE_UI_TOOLTIP(Mid Grey Nits, "Mid grey on screen at 100 nit SDR. 10 = the reference look; raised automatically for HDR.")
DEFINE_UI_TOOLTIP(Surround, "Viewing environment. Dark = the reference look (cinema). Dim and Bright lower contrast for brighter rooms.")
DEFINE_UI_TOOLTIP(Creative White, "White point of the rendered image on a D65 display. D60, D55 and D50 render white and greys progressively warmer. The image is scaled so white never clips.")

